# Local development only. Set a unique SECRET_KEY and your local PostgreSQL credentials.
SECRET_KEY=replace-with-a-random-local-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=nhl_web_app
POSTGRES_USER=nhl_web_app
POSTGRES_DB_PASSWORD=replace-with-your-local-database-password
STATIC_URL=/static/
MEDIA_URL=/media/
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_PASSWORD=

# file: JSON in logs/nhl_web_app.log, with host-managed logrotate.
# console: JSON on stderr for systemd/journald; no application file is opened.
NHL_LOG_DESTINATION=file

# Opt-in server automation. RabbitMQ must be provisioned separately.
NHL_SCHEDULING_ENABLED=False
CELERY_BROKER_URL=
# Cadences in seconds; UTC maintenance window. See docs/celery-operations.md.
NHL_LIVE_SECONDS=300
NHL_DISCOVERY_SECONDS=300
NHL_QUIET_DISCOVERY_SECONDS=1800
NHL_FINAL_SECONDS=600
NHL_FINAL_WINDOW_SECONDS=3600
NHL_MAINTENANCE_SECONDS=900
NHL_PRE_GAME_SECONDS=3600
NHL_COOLDOWN_SECONDS=300
NHL_QUIET_START_HOUR=9
NHL_QUIET_HOURS=3
NHL_WEEKLY_WEEKDAY=0
NHL_RECENT_DAYS=3
NHL_RUN_RETENTION_DAYS=30
